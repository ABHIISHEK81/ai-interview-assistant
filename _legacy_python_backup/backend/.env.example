# Backend Environment Variables
# Configure these in your backend deployment platform (Render, Railway, Fly.io, etc.)

# Port to listen on (automatically provided by Render/Railway)
PORT=8000

# Environment mode: "development" (enables auto-reload) or "production"
ENVIRONMENT=production

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend URL(s) for CORS. Can be comma-separated list of origins:
# e.g., https://your-site.netlify.app,https://yourdomain.com
FRONTEND_URL=https://YOUR-FRONTEND-APP.netlify.app
