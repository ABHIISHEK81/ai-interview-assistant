# =============================================
# AI Interview App - Backend Environment Variables
# Reference: interviewAI PDF Documentation pp. 45-46 & Addendum
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Full connection string (Atlas or local). If unreachable locally, automatic memory-db fallback is used.
MONGO_URI=mongodb://localhost:27017/ai_interviewer

# JWT Candidate Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=super_secret_refresh_token_key_at_least_32_characters_long_98765
JWT_REFRESH_EXPIRE=30d

# Admin JWT Authentication (Separate isolated secrets per PDF pp. 11-12, 52)
ADMIN_JWT_SECRET=admin_super_secret_jwt_key_at_least_32_chars_long_admin_12345
ADMIN_JWT_EXPIRE=1d
ADMIN_JWT_REFRESH_SECRET=admin_super_secret_refresh_token_key_at_least_32_chars_98765
ADMIN_JWT_REFRESH_EXPIRE=7d

# Groq AI (Free LLM API - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Embedding Provider Switch: 'local' (100% Free, zero cost, local TF/vector) or 'openai' (pay-as-you-go)
EMBEDDING_PROVIDER=local

# Required if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_actual_openai_api_key_here

# Cloudinary (Resume/File Storage - Free tier available at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (CORS & Socket.io Origin)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (optional — set REDIS_ENABLED=false to run without Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Adzuna Job Search (optional - https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
ADZUNA_PREFETCH_PAGES=3

# Payments (Stripe TEST MODE ONLY - Never use live keys)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_pub_key
