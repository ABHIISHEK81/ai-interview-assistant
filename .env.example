# ==============================================================================
# AI Interview Assistant - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Deploy on Render, Railway, Fly.io, etc.)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend URL(s) for CORS (comma-separated if multiple):
FRONTEND_URL=http://localhost:3000,https://YOUR-FRONTEND-APP.netlify.app

# ------------------------------------------------------------------------------
# Authentication & OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign HS256 JWT auth tokens (generate a strong random string)
JWT_SECRET=super_secret_jwt_signing_key_change_in_production

# Google Cloud OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# LinkedIn Developer Portal Credentials (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback

# ------------------------------------------------------------------------------
# Frontend Configuration (Deploy on Netlify)
# ------------------------------------------------------------------------------
# In Netlify dashboard: Site configuration -> Environment variables -> Add a variable
VITE_API_URL=https://YOUR-BACKEND-SERVICE.onrender.com

