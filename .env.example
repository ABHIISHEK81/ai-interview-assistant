# ==============================================================================
# InterviewAI - Global Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Express REST API & Socket.io)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (defaults to local in-memory fallback if not provided)
MONGO_URI=mongodb://localhost:27017/ai_interviewer

# Candidate Authentication Secrets (HS256 JWT, min 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=super_secret_refresh_token_key_at_least_32_characters_long_98765
JWT_REFRESH_EXPIRE=30d

# Dedicated Administrator Authentication Secrets (Strict RBAC Isolation)
ADMIN_JWT_SECRET=admin_super_secret_jwt_key_at_least_32_chars_long_admin_12345
ADMIN_JWT_EXPIRE=1d
ADMIN_JWT_REFRESH_SECRET=admin_super_secret_refresh_token_key_at_least_32_chars_98765
ADMIN_JWT_REFRESH_EXPIRE=7d

# AI Engine Credentials (Groq LLaMA 3.3 70B & Local Embeddings)
GROQ_API_KEY=gsk_your_groq_api_key_here
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# Client Web Application URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# Rate Limiting Guardrails
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Optional Redis Cache (Fallback to in-process cache if false)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudinary Storage (Optional for profile avatars & document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Billing (Optional for payment gateways)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite SPA)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME="InterviewAI Career Platform"
